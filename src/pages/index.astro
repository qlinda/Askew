---
import Presentation from "../components/Presentation.astro";

const base = import.meta.env.BASE_URL.endsWith("/")
    ? import.meta.env.BASE_URL
    : `${import.meta.env.BASE_URL}/`;

const startYear = 2023;
const endYear = 2026;

/*
`position` is where the project sits on the slider, so
projects that share a year get their own point.
*/
const projects = [
	{ title: "Green House", year: 2024, position: 2024, image: "green-house.jpg", width: 581, height: 872 },
	{ title: "Timber Cabin", year: 2024, position: 2024.5, image: "timber-cabin.jpg", width: 700, height: 467 },
	{ title: "Cob Construction", year: 2025, position: 2025, image: "cob-construction.jpg", width: 736, height: 1104 },
	{ title: "Materials Research", year: 2025, position: 2025.5, image: "materials-research.jpg", width: 1200, height: 1500 },
	{ title: "Bamboo Research Center", year: 2026, position: 2026, image: "bamboo-research-center.jpg", width: 1200, height: 847 },
];

const sliderPercent = (position) =>
	((position - startYear) / (endYear - startYear)) * 100;
---

<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width" />
	<title>ASKEW</title>

	<style>
		:root {
			--bg: #eeeeec;
			--ink: #111111;
			--muted: #686868;
			--red: #ff4a2d;
			--blue: #4c63ff;
		}

		* {
			box-sizing: border-box;
		}

		html,
		body {
			margin: 0;
			width: 100%;
			min-height: 100%;
			background: var(--bg);
			color: var(--ink);
		}

		body {
			font-family: "Courier New", Courier, monospace;
		}

		a {
			color: inherit;
			text-decoration: none;
		}

		.page {
			position: relative;
			width: 100%;
			height: 100vh;
			min-height: 650px;
			overflow: hidden;
		}


		/* ========================================
		   HEADER
		======================================== */

		.logo {
			position: absolute;
			top: 38px;
			left: 16px;
			font-size: 24px;
			font-weight: 400;
			line-height: 1;
			z-index: 50;
		}

		.logo:hover {
			opacity: 0.5;
		}

		.nav {
			position: absolute;
			top: 38px;
			left: 50%;
			display: flex;
			flex-direction: column;
			gap: 8px;
			font-size: 24px;
			font-weight: 400;
			line-height: 1.2;
			z-index: 50;
		}

		.nav a:hover {
			opacity: 0.5;
		}


		/* ========================================
		   GEOMETRIC CROSS
		======================================== */

		.cross {
			position: absolute;
			width: 20px;
			height: 20px;
			transform: translate(-10px, -10px);
			pointer-events: none;
			z-index: 20;
		}

		.cross::before,
		.cross::after {
			content: "";
			position: absolute;
			display: block;
			background: currentColor;
		}

		.cross::before {
			width: 20px;
			height: 1px;
			left: 0;
			top: 10px;
		}

		.cross::after {
			width: 1px;
			height: 20px;
			left: 10px;
			top: 0;
		}

		.cross.red {
			color: var(--red);
		}

		.cross.blue {
			color: var(--blue);
		}

		.cross.black {
			color: var(--ink);
		}


		/* ========================================
		   LEFT REGISTRATION LINE
		======================================== */

		.logo-cross {
			left: 29px;
			top: 82px;
		}

		.left-line {
			position: absolute;
			left: 29px;
			top: 82px;
			width: 1px;
			height: calc(100vh - 165px);
			background: var(--ink);
			transform: translateX(-0.5px);
			opacity: 0.75;
		}

		.bottom-cross {
			left: 29px;
			bottom: 20px;
		}


		/* ========================================
		   TIMELINE
		======================================== */

		.timeline-area {
			position: absolute;
			left: 6%;
			right: 5%;
			top: 58%;
			height: 300px;
		}

		.timeline-track {
			position: absolute;
			left: 0;
			right: 0;
			top: 100px;
			height: 1px;
			background: var(--ink);
			transform: translateY(-0.5px);
		}

		.timeline-start,
		.timeline-end {
			position: absolute;
			top: 112px;
			font-size: 14px;
			letter-spacing: 0.04em;
			color: var(--muted);
			user-select: none;
		}

		.timeline-start {
			left: 0;
		}

		.timeline-end {
			right: 0;
			text-align: right;
		}

		.end-cross {
			left: 100%;
			top: 100px;
		}


		/* ========================================
		   DRAGGER
		======================================== */

		.dragger {
			position: absolute;
			left: 30%;
			top: 100px;
			width: 32px;
			height: 350px;
			transform: translate(-50%, -50%);
			cursor: ew-resize;
			touch-action: none;
			z-index: 30;
		}

		.dragger-line {
			position: absolute;
			left: 50%;
			top: 0;
			width: 1px;
			height: 350px;
			background: var(--ink);
			transform: translateX(-0.5px);
		}

		.dragger-cross {
			left: 50%;
			top: 50%;
			color: var(--red);
		}

		.current-year {
			position: absolute;
			left: 50%;
			top: calc(50% + 22px);
			transform: translateX(-50%);
			font-size: 11px;
			letter-spacing: 0.06em;
			color: var(--muted);
			white-space: nowrap;
			opacity: 0;
			transition: opacity 150ms ease;
		}

		.dragger:hover .current-year,
		.dragger.dragging .current-year {
			opacity: 1;
		}


		/* Project year ticks */

		.timeline-tick {
			position: absolute;
			top: 94px;
			width: 1px;
			height: 12px;
			background: var(--ink);
			transform: translateX(-0.5px);
			pointer-events: none;
		}


		/* ========================================
		   PROJECT IMAGES
		======================================== */

		/*
		Images sit inside the timeline area so each
		one can be centred over its own slider point.
		JS sizes and nudges them to stay on screen.
		*/

		.project-cluster {
			position: absolute;
			left: 0;
			right: 0;
			top: 0;
			height: 100px;
			pointer-events: none;
			z-index: 35;
		}

		.project-thumb {
			position: absolute;
			bottom: 12px;
			display: block;
			padding: 0;
			border: 0;
			background: none;
			color: inherit;
			font: inherit;
			text-align: left;
			cursor: zoom-in;
			opacity: 0;
			transform: translateY(12px);
			transition:
				opacity 350ms ease,
				transform 350ms ease;
			pointer-events: none;
		}

		.project-thumb.visible {
			opacity: 1;
			transform: translateY(0);
			pointer-events: auto;
		}

		.project-thumb:hover {
			z-index: 40;
		}

		.project-thumb img {
			display: block;
			width: 300px;
			height: auto;
			object-fit: cover;
			border: 0;
			transition: transform 180ms ease;
		}

		.project-thumb:hover img {
			transform: scale(1.025);
		}

		.thumb-label {
			display: block;
			margin-top: 5px;
			font-size: 10px;
			letter-spacing: 0.04em;
			color: var(--muted);
		}

		.thumb-title {
			display: block;
			margin-bottom: 8px;
			font-size: 12px;
			letter-spacing: 0.06em;
			color: var(--muted);
			white-space: nowrap;
		}


		/* ========================================
		   FULLSCREEN GALLERY
		======================================== */

		.gallery {
			width: 100vw;
			height: 100vh;
			max-width: none;
			max-height: none;
			margin: 0;
			padding: 0;
			border: 0;
			background: var(--bg);
			color: var(--ink);
			font-family: "Courier New", Courier, monospace;
			overflow: hidden;
		}

		.gallery::backdrop {
			background: var(--bg);
		}

		.gallery[open] {
			animation: gallery-in 250ms ease;
		}

		@keyframes gallery-in {
			from { opacity: 0; }
			to { opacity: 1; }
		}

		.gallery button {
			padding: 0;
			border: 0;
			background: none;
			color: inherit;
			font: inherit;
			cursor: pointer;
		}

		.gallery button:hover {
			opacity: 0.5;
		}

		.gallery-title {
			position: absolute;
			top: 38px;
			left: 16px;
			font-size: 24px;
			line-height: 1;
		}

		.gallery-close {
			position: absolute;
			top: 38px;
			right: 25px;
			font-size: 14px;
			letter-spacing: 0.06em;
		}

		.gallery-stage {
			position: absolute;
			inset: 100px 90px 80px;
			margin: 0;
			display: flex;
			align-items: center;
			justify-content: center;
		}

		.gallery-stage img {
			display: block;
			max-width: 100%;
			max-height: 100%;
			object-fit: contain;
		}

		.gallery-arrow {
			position: absolute;
			top: 50%;
			transform: translateY(-50%);
			font-size: 28px;
			padding: 20px !important;
		}

		.gallery-prev {
			left: 16px;
		}

		.gallery-next {
			right: 16px;
		}

		.gallery-caption {
			position: absolute;
			left: 16px;
			right: 25px;
			bottom: 30px;
			display: flex;
			justify-content: space-between;
			font-size: 12px;
			letter-spacing: 0.06em;
			color: var(--muted);
		}


		/* ========================================
		   TAGLINE
		======================================== */

		.tagline {
			position: absolute;
			left: 6.5%;
			bottom: 58px;
			font-size: 22px;
			font-weight: 400;
			line-height: 1.5;
			letter-spacing: 0.04em;
			z-index: 10;
		}


		/* ========================================
		   MOBILE
		======================================== */

		@media (max-width: 700px) {

			.logo {
				font-size: 20px;
			}

			.nav {
				left: auto;
				right: 25px;
				font-size: 20px;
			}

			.timeline-area {
				left: 10%;
				right: 8%;
			}

			.tagline {
				font-size: 17px;
			}

			.gallery-title {
				font-size: 20px;
			}

			.gallery-stage {
				inset: 90px 16px 80px;
			}

			.gallery-arrow {
				top: auto;
				bottom: 50px;
				transform: none;
			}

			.gallery-caption {
				justify-content: center;
				gap: 16px;
			}
		}
	</style>
</head>


<body>

	<main class="page">


		<!-- HOME BUTTON -->

		<a href={base} class="logo">
			ASKEW
		</a>

		<span class="cross red logo-cross"></span>

		<div class="left-line"></div>

		<span class="cross blue bottom-cross"></span>


		<!-- NAVIGATION -->

		<nav class="nav">

			<a href={`${base}mission/`}>
				MISSION
			</a>
		
			<a href={`${base}projects/`}>
				PROJECTS
			</a>
		
			<a href={`${base}contact/`}>
				CONTACT
			</a>

			<button
				type="button"
				class="nav-more"
				data-open-presentation
			>
				MORE
			</button>

		</nav>


		<!-- FULLSCREEN GALLERY -->

		<dialog
			class="gallery"
			id="gallery"
			aria-label="Project gallery"
		>

			<div
				class="gallery-title"
				id="galleryTitle"
			></div>

			<button
				type="button"
				class="gallery-close"
				id="galleryClose"
				aria-label="Close gallery"
			>
				CLOSE ✕
			</button>

			<figure class="gallery-stage">
				<img id="galleryImage" src="" alt="" />
			</figure>

			<button
				type="button"
				class="gallery-arrow gallery-prev"
				id="galleryPrev"
				aria-label="Previous image"
			>
				←
			</button>

			<button
				type="button"
				class="gallery-arrow gallery-next"
				id="galleryNext"
				aria-label="Next image"
			>
				→
			</button>

			<div class="gallery-caption">
				<span id="galleryLabel"></span>
				<span id="galleryCount"></span>
			</div>

		</dialog>


		<!-- FULLSCREEN PRESENTATION (MORE) -->

		<Presentation />


		<!-- TIMELINE -->

		<section
			class="timeline-area"
			id="timeline"
		>

			<div class="timeline-track"></div>

			{projects.map((project) => (
				<span
					class="timeline-tick"
					style={`left: ${sliderPercent(project.position)}%`}
				></span>
			))}

			<!-- PROJECT IMAGES -->

			<div
				class="project-cluster"
				id="projectCluster"
			>

				{projects.map((project) => (
					<button
						type="button"
						class="project-thumb"
						data-title={project.title.toUpperCase()}
						data-year={project.year}
						data-position={project.position}
						style={`left: ${sliderPercent(project.position)}%`}
					>
						<span class="thumb-title">
							{project.title.toUpperCase()} / {project.year}
						</span>
						<img
							src={`${base}images/${project.image}`}
							alt={project.title}
							width={project.width}
							height={project.height}
						/>
						<span class="thumb-label">
							VIEW ↗
						</span>
					</button>
				))}

			</div>


			<div class="timeline-start">
				{startYear}
			</div>

			<div class="timeline-end">
				PRESENT
			</div>

			<span
				class="cross black end-cross"
			></span>


			<!-- DRAGGABLE LINE -->

			<div
				class="dragger"
				id="dragger"
				role="slider"
				aria-label="Project timeline"
				aria-valuemin={startYear}
				aria-valuemax={endYear}
				aria-valuenow={startYear}
				tabindex="0"
			>

				<div class="dragger-line"></div>

				<span
					class="cross red dragger-cross"
				></span>

				<div
					class="current-year"
					id="currentYear"
				>
					{startYear}
				</div>

			</div>

		</section>


		<!-- TAGLINE -->

		<div class="tagline">
			architecture for making
			<br />
			differently
		</div>

	</main>


	<script>

		const timeline =
			document.getElementById("timeline");

		const dragger =
			document.getElementById("dragger");

		const currentYear =
			document.getElementById("currentYear");

		const projectThumbs =
			document.querySelectorAll(".project-thumb");


		const startYear = 2023;
		const endYear = 2026;

		let dragging = false;


		/* -------------------------------------
		   SHOW / HIDE PROJECTS
		------------------------------------- */

		function updateProject(year) {

			/*
			Show the project closest to the
			slider, if one is within reach.
			*/

			let nearest = null;
			let nearestDistance = 0.65;

			projectThumbs.forEach(
				(thumb) => {

					const distance =
						Math.abs(
							Number(thumb.dataset.position) - year
						);

					if (distance < nearestDistance) {
						nearest = thumb;
						nearestDistance = distance;
					}

				}
			);


			projectThumbs.forEach(
				(thumb) => {

					thumb
						.classList
						.toggle("visible", thumb === nearest);

				}
			);

		}


		/* -------------------------------------
		   SIZE + PLACE PROJECT IMAGES
		------------------------------------- */

		/*
		Each image is first fitted as large as it can
		be (up to 18% of the screen) without running
		off the top of the screen or into the nav,
		then scaled down by imageScale. It is centred
		over its slider point, sliding sideways to
		stay inside the screen edges.
		*/

		const targetArea = 0.18;
		const imageScale = 0.75;
		const edgeGap = 16;
		const nav = document.querySelector(".nav");

		function layoutThumbs() {

			const timelineRect =
				timeline.getBoundingClientRect();

			if (timelineRect.width === 0) return;

			const navRect =
				nav.getBoundingClientRect();

			const screenArea =
				window.innerWidth * window.innerHeight;

			projectThumbs.forEach(
				(thumb) => {

					const image =
						thumb.querySelector("img");

					const ratio =
						Number(image.getAttribute("width")) /
						Number(image.getAttribute("height"));

					const tickX =
						timelineRect.left +
						(
							(Number(thumb.dataset.position) - startYear) /
							(endYear - startYear)
						) *
						timelineRect.width;

					/* Room taken by the title and VIEW label */
					const captionHeight =
						thumb.offsetHeight - image.offsetHeight;

					/* Where the bottom of the image block sits */
					const blockBottom =
						timelineRect.top + 100 - 12;

					/*
					Keep the slider point under the image, not just
					at an edge (less margin when the point is near
					the side of the screen).
					*/
					const tickInset =
						Math.max(
							0,
							Math.min(
								40,
								tickX - edgeGap,
								window.innerWidth - edgeGap - tickX
							)
						);


					/*
					For a given width, find where the image can go:
					centred over the point if possible, otherwise
					slid sideways (point still underneath) to clear
					the nav and the screen edges. Returns null if
					there is no room.
					*/
					function place(w) {

						const top =
							blockBottom - captionHeight - w / ratio;

						if (top < edgeGap) return null;

						const minLeft =
							Math.max(edgeGap, tickX + tickInset - w);

						const maxLeft =
							Math.min(
								window.innerWidth - edgeGap - w,
								tickX - tickInset
							);

						if (minLeft > maxLeft) return null;

						const clamp = (x) =>
							Math.min(Math.max(x, minLeft), maxLeft);

						const centred =
							clamp(tickX - w / 2);

						if (top >= navRect.bottom + edgeGap) {
							return centred;
						}

						/* Image reaches nav height: it must sit beside the nav */
						const candidates = [
							centred,
							clamp(navRect.right + edgeGap),
							clamp(navRect.left - edgeGap - w),
						].filter(
							(x) =>
								x + w <= navRect.left - edgeGap + 0.5 ||
								x >= navRect.right + edgeGap - 0.5
						);

						if (candidates.length === 0) return null;

						return candidates.reduce(
							(best, x) =>
								Math.abs(x - centred) < Math.abs(best - centred)
									? x
									: best
						);

					}


					let width =
						Math.min(
							Math.sqrt(screenArea * targetArea * ratio),
							window.innerWidth - edgeGap * 2
						);

					let left = place(width);

					while (left === null && width > 120) {
						width -= 10;
						left = place(width);
					}

					width *= imageScale;
					left = place(width);

					if (left === null) {
						left = Math.max(edgeGap, tickX - width / 2);
					}

					image.style.width =
						`${width}px`;

					thumb.style.left =
						`${left - timelineRect.left}px`;

				}
			);

		}

		window.addEventListener(
			"resize",
			layoutThumbs
		);


		/* -------------------------------------
		   MOVE TIMELINE
		------------------------------------- */

		function setPosition(clientX) {

			const rect =
				timeline.getBoundingClientRect();

			if (rect.width === 0) return;


			let x =
				clientX - rect.left;


			x = Math.max(
				0,
				Math.min(x, rect.width)
			);


			const percentage =
				x / rect.width;


			dragger.style.left =
				`${percentage * 100}%`;


			const exactYear =
				startYear +
				percentage *
				(endYear - startYear);


			const displayedYear =
				Math.round(exactYear);


			currentYear.textContent =
				displayedYear === endYear
					? "PRESENT"
					: displayedYear;


			dragger.setAttribute(
				"aria-valuenow",
				String(displayedYear)
			);


			updateProject(exactYear);

		}


		/* -------------------------------------
		   DRAG
		------------------------------------- */

		dragger.addEventListener(
			"pointerdown",
			(event) => {

				dragging = true;

				dragger
					.classList
					.add("dragging");

				dragger.setPointerCapture(
					event.pointerId
				);

				setPosition(
					event.clientX
				);

			}
		);


		dragger.addEventListener(
			"pointermove",
			(event) => {

				if (!dragging) return;

				setPosition(
					event.clientX
				);

			}
		);


		dragger.addEventListener(
			"pointerup",
			(event) => {

				dragging = false;

				dragger
					.classList
					.remove("dragging");

				dragger.releasePointerCapture(
					event.pointerId
				);

			}
		);


		/* Click timeline to move */

		timeline.addEventListener(
			"pointerdown",
			(event) => {

				if (
					event.target.closest("#dragger") ||
					event.target.closest(".project-thumb")
				) {
					return;
				}

				setPosition(
					event.clientX
				);

			}
		);


		/* Keyboard */

		dragger.addEventListener(
			"keydown",
			(event) => {

				const rect =
					timeline.getBoundingClientRect();


				const currentLeft =
					parseFloat(
						dragger.style.left || "30"
					) / 100;


				let percentage =
					currentLeft;


				if (event.key === "ArrowLeft") {
					percentage -= 0.02;
				}


				if (event.key === "ArrowRight") {
					percentage += 0.02;
				}


				percentage =
					Math.max(
						0,
						Math.min(
							1,
							percentage
						)
					);


				setPosition(
					rect.left +
					percentage *
					rect.width
				);

			}
		);


		/* Start on the first project */

		function setInitialPosition() {

			layoutThumbs();

			const initialRect =
				timeline.getBoundingClientRect();

			setPosition(
				initialRect.left +
				0.3 *
				initialRect.width
			);

		}

		if (document.readyState === "complete") {
			setInitialPosition();
		}

		else {
			window.addEventListener(
				"load",
				setInitialPosition
			);
		}


		/* -------------------------------------
		   FULLSCREEN GALLERY
		------------------------------------- */

		const gallery =
			document.getElementById("gallery");

		const galleryImage =
			document.getElementById("galleryImage");

		const galleryTitle =
			document.getElementById("galleryTitle");

		const galleryLabel =
			document.getElementById("galleryLabel");

		const galleryCount =
			document.getElementById("galleryCount");

		let galleryIndex = 0;


		function showImage(index) {

			const total = projectThumbs.length;

			galleryIndex =
				(index + total) % total;

			const thumb =
				projectThumbs[galleryIndex];

			const thumbImage =
				thumb.querySelector("img");

			galleryImage.src = thumbImage.src;
			galleryImage.alt = thumbImage.alt;

			galleryTitle.textContent =
				thumb.dataset.title;

			galleryLabel.textContent =
				thumb.dataset.year;

			galleryCount.textContent =
				`${String(galleryIndex + 1).padStart(2, "0")} / ${String(total).padStart(2, "0")}`;

		}


		projectThumbs.forEach(
			(thumb, index) => {

				thumb.addEventListener(
					"click",
					() => {

						showImage(index);
						gallery.showModal();

					}
				);

			}
		);


		document
			.getElementById("galleryPrev")
			.addEventListener(
				"click",
				() => showImage(galleryIndex - 1)
			);

		document
			.getElementById("galleryNext")
			.addEventListener(
				"click",
				() => showImage(galleryIndex + 1)
			);

		document
			.getElementById("galleryClose")
			.addEventListener(
				"click",
				() => gallery.close()
			);


		/* Arrow keys browse, Escape closes (built into dialog) */

		gallery.addEventListener(
			"keydown",
			(event) => {

				if (event.key === "ArrowLeft") {
					showImage(galleryIndex - 1);
				}

				if (event.key === "ArrowRight") {
					showImage(galleryIndex + 1);
				}

			}
		);


		/* Click empty space around the image to close */

		gallery.addEventListener(
			"click",
			(event) => {

				if (
					event.target === gallery ||
					event.target.classList.contains("gallery-stage")
				) {
					gallery.close();
				}

			}
		);


		/* Swipe on touch screens */

		let touchStartX = null;

		gallery.addEventListener(
			"touchstart",
			(event) => {
				touchStartX = event.touches[0].clientX;
			},
			{ passive: true }
		);

		gallery.addEventListener(
			"touchend",
			(event) => {

				if (touchStartX === null) return;

				const deltaX =
					event.changedTouches[0].clientX - touchStartX;

				if (Math.abs(deltaX) > 50) {
					showImage(
						galleryIndex + (deltaX < 0 ? 1 : -1)
					);
				}

				touchStartX = null;

			}
		);

	</script>

</body>
</html>