---
const base = import.meta.env.BASE_URL.endsWith("/")
    ? import.meta.env.BASE_URL
    : `${import.meta.env.BASE_URL}/`;
---

<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width" />
	<title>About — ASKEW</title>

	<style>
		:root {
			--bg: #eeeeec;
			--ink: #111111;
			--muted: #686868;
			--red: #ff4a2d;
			--blue: #4c63ff;
		}

		* {
			box-sizing: border-box;
		}

		html,
		body {
			margin: 0;
			width: 100%;
			min-height: 100%;
			background: var(--bg);
			color: var(--ink);
		}

		body {
			font-family: "Courier New", Courier, monospace;
		}

		a {
			color: inherit;
			text-decoration: none;
		}

		.page {
			position: relative;
			width: 100%;
			min-height: 100vh;
			padding-bottom: 80px;
		}


		/* ========================================
		   HEADER
		   ======================================== */

		.logo {
			position: absolute;
			top: 38px;
			left: 16px;

			font-size: 24px;
			font-weight: 400;
			line-height: 1;
		}

		.logo:hover {
			opacity: 0.5;
		}

		.nav {
			position: absolute;
			top: 38px;
			left: 50%;

			display: flex;
			flex-direction: column;
			gap: 8px;

			font-size: 24px;
			font-weight: 400;
			line-height: 1.2;
		}

		.nav a:hover {
			opacity: 0.5;
		}

		.nav .active {
			text-decoration: underline;
			text-underline-offset: 5px;
		}


		/* ========================================
		   CROSS SYMBOL
		   ======================================== */

		.cross {
			position: absolute;
			width: 20px;
			height: 20px;
			transform: translate(-10px, -10px);
			pointer-events: none;
		}

		.cross::before,
		.cross::after {
			content: "";
			position: absolute;
			display: block;
			background: currentColor;
		}

		.cross::before {
			width: 20px;
			height: 1px;
			left: 0;
			top: 10px;
		}

		.cross::after {
			width: 1px;
			height: 20px;
			left: 10px;
			top: 0;
		}

		.cross.red {
			color: var(--red);
		}

		.cross.blue {
			color: var(--blue);
		}


		/* ========================================
		   LEFT REGISTRATION LINE
		   ======================================== */

		.logo-cross {
			left: 29px;
			top: 82px;
		}

		.left-line {
			position: absolute;
			left: 29px;
			top: 82px;

			width: 1px;
			height: calc(100vh - 165px);

			background: var(--ink);
			transform: translateX(-0.5px);
			opacity: 0.75;
		}

		.bottom-cross {
			left: 29px;
			bottom: 20px;
		}


		/* ========================================
		   ABOUT CONTENT
		   ======================================== */

		.about {
			position: relative;
			padding-top: 260px;

			margin-left: 14%;
			margin-right: 9%;

			max-width: 1250px;
		}

		.section-label {
			font-size: 12px;
			color: var(--muted);
			letter-spacing: 0.08em;

			margin-bottom: 28px;
		}

		.intro {
			max-width: 900px;

			font-size: clamp(24px, 2.5vw, 39px);
			line-height: 1.28;
			letter-spacing: -0.025em;

			margin: 0;
		}


		/* ========================================
		   ALIGNMENT LINE BETWEEN SECTIONS
		   ======================================== */

		.divider {
			position: relative;

			width: 100%;
			height: 1px;

			background: var(--ink);

			margin-top: 80px;
			margin-bottom: 65px;
		}

		.divider-cross {
			position: absolute;

			left: 33%;
			top: 0;
		}


		/* ========================================
		   WORKFLOW DIAGRAM
		   ======================================== */

		.workflow {
			margin: 0;
		}

		.workflow img {
			display: block;

			width: 100%;
			height: auto;

			/* drop the diagram's paper tone into the page background */
			mix-blend-mode: multiply;
		}


		/* ========================================
		   PROCESS STEPS
		   ======================================== */

		.steps {
			display: flex;
			flex-wrap: wrap;
			gap: 14px 48px;

			list-style: none;
			padding: 0;
			margin: 48px 0 0;

			font-size: 14px;
			letter-spacing: 0.06em;
		}

		.steps li {
			counter-increment: step;
		}

		.steps li::before {
			content: counter(step, decimal-leading-zero) " ";
			color: var(--muted);
			font-size: 11px;
		}


		/* ========================================
		   MOBILE
		   ======================================== */

		@media (max-width: 700px) {

			.logo {
				font-size: 20px;
			}

			.nav {
				left: auto;
				right: 25px;

				font-size: 20px;
			}

			.about {
				padding-top: 250px;

				margin-left: 15%;
				margin-right: 8%;
			}

			.intro {
				font-size: 23px;
			}

			/* keep the diagram legible: let it scroll sideways */
			.workflow {
				overflow-x: auto;
			}

			.workflow img {
				width: 900px;
				max-width: none;
			}
		}
	</style>
</head>


<body>

	<main class="page">


		<!-- ASKEW -->

		<a href={base} class="logo">
			ASKEW
		</a>

		<span class="cross red logo-cross"></span>

		<div class="left-line"></div>

		<span class="cross blue bottom-cross"></span>



		<!-- NAVIGATION -->

		<nav class="nav">

			<a href={`${base}mission/`}>
				MISSION
			</a>

			<a href={`${base}projects/`}>
				PROJECTS
			</a>

			<a href={`${base}about/`} class="active">
				ABOUT
			</a>

			<a href={`${base}contact/`}>
				CONTACT
			</a>

		</nav>



		<!-- ABOUT -->

		<section class="about">

			<div class="section-label">
				01 / ABOUT
			</div>

			<p class="intro">
				We are a nonprofit architecture practice working with local
				materials, craftspeople, and communities.
			</p>



			<!-- drafting divider -->

			<div class="divider">
				<span class="cross red divider-cross"></span>
			</div>



			<!-- HOW WE WORK -->

			<div class="section-label">
				02 / HOW WE WORK
			</div>

			<figure class="workflow">
				<img
					src={`${base}images/askew-workflow.png`}
					width="1536"
					height="1024"
					loading="lazy"
					decoding="async"
					alt="Askew workflow diagram. Four core roles — Designer / Architect (design, permits), Programs / Relations (funding, workshops, partners), Operations (budget, contracts, logistics) and Site Manager (construction, fabrication) — are linked in a loop. Clients, a visiting researcher / designer and interns feed into them, with consultants, funders and contractors connecting from outside."
				/>
			</figure>

			<ol class="steps">
				<li>OPPORTUNITY</li>
				<li>RESEARCH</li>
				<li>SOURCE</li>
				<li>DESIGN</li>
				<li>BUILD</li>
				<li>SHARE</li>
			</ol>

		</section>

	</main>

</body>
</html>
