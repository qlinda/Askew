---
import Presentation from "../components/Presentation.astro";

const base = import.meta.env.BASE_URL.endsWith("/")
    ? import.meta.env.BASE_URL
    : `${import.meta.env.BASE_URL}/`;
---

<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width" />
	<title>About — ASKEW</title>

	<style>
		:root {
			--bg: #eeeeec;
			--ink: #111111;
			--muted: #686868;
			--red: #ff4a2d;
			--blue: #4c63ff;
		}

		* {
			box-sizing: border-box;
		}

		html,
		body {
			margin: 0;
			width: 100%;
			min-height: 100%;
			background: var(--bg);
			color: var(--ink);
		}

		body {
			font-family: "Courier New", Courier, monospace;
		}

		a {
			color: inherit;
			text-decoration: none;
		}

		.page {
			position: relative;
			width: 100%;
			min-height: 100vh;
			padding-bottom: 80px;
		}


		/* ========================================
		   HEADER
		   ======================================== */

		.logo {
			position: absolute;
			top: 38px;
			left: 16px;

			font-size: 24px;
			font-weight: 400;
			line-height: 1;
		}

		.nav {
			position: absolute;
			top: 38px;
			left: 50%;

			display: flex;
			flex-direction: column;
			gap: 8px;

			font-size: 24px;
			font-weight: 400;
			line-height: 1.2;
			z-index: 50;
		}

		.nav a:hover {
			opacity: 0.5;
		}

		.nav .active {
			text-decoration: underline;
			text-underline-offset: 5px;
		}


		/* ========================================
		   CROSS SYMBOL
		   ======================================== */

		.cross {
			position: absolute;
			width: 20px;
			height: 20px;
			transform: translate(-10px, -10px);
			pointer-events: none;
		}

		.cross::before,
		.cross::after {
			content: "";
			position: absolute;
			display: block;
			background: currentColor;
		}

		.cross::before {
			width: 20px;
			height: 1px;
			left: 0;
			top: 10px;
		}

		.cross::after {
			width: 1px;
			height: 20px;
			left: 10px;
			top: 0;
		}

		.cross.red {
			color: var(--red);
		}

		.cross.blue {
			color: var(--blue);
		}


		/* ========================================
		   LEFT REGISTRATION LINE
		   ======================================== */

		.logo-cross {
			left: 29px;
			top: 82px;
		}

		.left-line {
			position: absolute;
			left: 29px;
			top: 82px;

			width: 1px;
			height: calc(100vh - 165px);

			background: var(--ink);
			transform: translateX(-0.5px);
			opacity: 0.75;
		}

		.bottom-cross {
			left: 29px;
			bottom: 20px;
		}


		/* ========================================
		   ABOUT CONTENT
		   ======================================== */

		.about {
			position: relative;
			padding-top: 260px;

			margin-left: 14%;
			margin-right: 9%;

			max-width: 1250px;
		}

		.about-label {
			font-size: 12px;
			color: var(--muted);
			letter-spacing: 0.08em;

			margin-bottom: 28px;
		}


		/* Photo beside the founder statement */

		.founder {
			display: grid;

			grid-template-columns:
				minmax(0, 5fr) minmax(0, 7fr);

			column-gap: 8%;
			align-items: start;
		}

		.photo {
			position: relative;
			margin: 0;
		}

		.photo img {
			display: block;
			width: 100%;
			height: auto;
		}

		/* Registration mark on the photo's corner */
		.photo-cross {
			left: 0;
			top: 0;
		}

		.block-number {
			display: block;

			font-size: 11px;
			color: var(--muted);

			margin-bottom: 18px;

			letter-spacing: 0.08em;
		}

		.statement {
			max-width: 640px;

			font-size: clamp(18px, 1.6vw, 24px);
			line-height: 1.5;
			letter-spacing: -0.01em;

			margin: 0;
		}


		/* ========================================
		   ALIGNMENT LINE
		   ======================================== */

		.divider {
			position: relative;

			width: 100%;
			height: 1px;

			background: var(--ink);

			margin-top: 80px;
		}

		.divider-cross {
			position: absolute;

			left: 33%;
			top: 0;
		}


		/* ========================================
		   SMALL QUIRK / REGISTRATION MARK
		   ======================================== */

		.side-note {
			position: absolute;

			right: 4%;
			top: 58%;

			font-size: 11px;
			line-height: 1.5;

			color: var(--muted);

			writing-mode: vertical-rl;
		}


		/* ========================================
		   MOBILE
		   ======================================== */

		@media (max-width: 700px) {

			.logo {
				font-size: 20px;
			}

			.nav {
				left: auto;
				right: 25px;

				font-size: 20px;
			}

			.about {
				padding-top: 250px;

				margin-left: 15%;
				margin-right: 8%;
			}

			.founder {
				grid-template-columns: 1fr;
				row-gap: 45px;
			}

			.statement {
				font-size: 18px;
			}

			.side-note {
				display: none;
			}
		}
	</style>
</head>


<body>

	<main class="page">


		<!-- ASKEW -->

		<a href={base} class="logo">
			ASKEW
		</a>

		<span
			class="cross red logo-cross"
		></span>

		<div class="left-line"></div>

		<span
			class="cross blue bottom-cross"
		></span>



		<!-- NAVIGATION -->

		<nav class="nav">

			<a href={`${base}mission/`}>
				MISSION
			</a>

			<a href={`${base}projects/`}>
				PROJECTS
			</a>

			<a
				href={`${base}about/`}
				class="active"
			>
				ABOUT
			</a>

			<button
				type="button"
				class="nav-more"
				data-open-presentation
			>
				MORE
			</button>

		</nav>


		<!-- FULLSCREEN PRESENTATION (MORE) -->

		<Presentation />



		<!-- ABOUT -->

		<section class="about">

			<div class="about-label">
				01 / ABOUT
			</div>


			<div class="founder">


				<!-- PHOTO -->

				<figure class="photo">

					<img
						src={`${base}images/founder.jpg`}
						width="1407"
						height="1600"
						decoding="async"
						alt="Black-and-white photo of a person smiling from the open back of a converted ambulance strung with lights, with two people standing outside."
					/>

					<span
						class="cross red photo-cross"
					></span>

				</figure>



				<!-- FOUNDER STATEMENT -->

				<div>

					<span class="block-number">
						02 / FOUNDER
					</span>

					<p class="statement">
						As the founder of Askew, I am interested
						in exploring alternative ways of living
						that foster deeper connections to nature,
						community, and creativity. Years spent
						embracing a nomadic, nature-oriented
						lifestyle have shaped my belief that life
						can exist beyond the productivity-driven
						structures of cities. Through Askew, I hope
						to make space for different ways of living
						by creating architecture that is accessible,
						affordable, and rooted in a more meaningful
						relationship with the natural world.
					</p>

				</div>


			</div>



			<!-- drafting divider -->

			<div class="divider">

				<span
					class="cross red divider-cross"
				></span>

			</div>

		</section>


		<div class="side-note">
			NATURE / COMMUNITY / CREATIVITY
		</div>


	</main>

</body>
</html>
